function template(locals) {var pug_html = "", pug_mixins = {}, pug_interp;pug_html = pug_html + "\u003Cdiv class=\"content\"\u003E\u003Cdiv class=\"header-section\"\u003E\u003Cdiv class=\"d-flex justify-content-between align-items-center\"\u003E\u003Ch3 translate=\"opaqueglasshomepage.ui.connections\"\u003E\u003C\u002Fh3\u003E\u003Cbutton class=\"btn btn-primary\" (click)=\"createConnection()\"\u003E\u003Ci class=\"fas fa-plus me-2\"\u003E\u003C\u002Fi\u003E\u003Cspan translate=\"opaqueglasshomepage.ui.newprofile\"\u003E\u003C\u002Fspan\u003E\u003C\u002Fbutton\u003E\u003C\u002Fdiv\u003E\u003Cdiv class=\"form-group my-3\"\u003E\u003Cinput class=\"form-control\" #ogchsearchInput type=\"text\" [placeholder]=\"'opaqueglasshomepage.ui.searchPlaceholder' | translate\" [(ngModel)]=\"searchQuery\" (input)=\"searchConnections()\" (keyup.enter)=\"onSearchEnter()\" (keyup.control.enter)=\"onQuickConnect()\" (keyup.meta.enter)=\"onQuickConnect()\" (compositionend)=\"onCompositionEnd($event)\"\u003E\u003C\u002Fdiv\u003E\u003C\u002Fdiv\u003E\u003Cdiv class=\"scroll-container\"\u003E\u003Cdiv *ngFor=\"let group of groups\"\u003E\u003Ch5 class=\"group-title\" [title]=\"group.name\"\u003E{{ group.name }}\u003C\u002Fh5\u003E\u003Cdiv class=\"connection-group\"\u003E\u003Cdiv *ngFor=\"let conn of group.connections\"\u003E\u003Cdiv class=\"card clickable-card\" (click)=\"openConnection(conn)\"\u003E\u003Cdiv class=\"card-options\" (click)=\"$event.stopPropagation()\"\u003E\u003Cdiv ngbDropdown placement=\"bottom-end\" container=\"body\"\u003E\u003Cbutton class=\"btn btn-link text-muted\" ngbDropdownToggle\u003E\u003Ci class=\"fas fa-ellipsis-v\"\u003E\u003C\u002Fi\u003E\u003C\u002Fbutton\u003E\u003Cdiv ngbDropdownMenu\u003E\u003C!-- ... 菜单项--\u003E\u003Cbutton class=\"dropdown-item\" ngbDropdownItem (click)=\"editConnection(conn)\"\u003E\u003Ci class=\"fas fa-fw fa-edit me-2\"\u003E\u003C\u002Fi\u003E\u003Cspan translate\u003EEdit\u003C\u002Fspan\u003E\u003C\u002Fbutton\u003E\u003Cbutton class=\"dropdown-item\" ngbDropdownItem (click)=\"cloneConnection(conn)\"\u003E\u003Ci class=\"fas fa-fw fa-copy me-2\"\u003E\u003C\u002Fi\u003E\u003Cspan translate\u003EDuplicate\u003C\u002Fspan\u003E\u003C\u002Fbutton\u003E\u003Cdiv class=\"dropdown-divider\"\u003E\u003C\u002Fdiv\u003E\u003Cbutton class=\"dropdown-item text-danger\" ngbDropdownItem (click)=\"deleteConnection(conn)\"\u003E\u003Ci class=\"fas fa-fw fa-trash me-2\"\u003E\u003C\u002Fi\u003E\u003Cspan translate\u003EDelete\u003C\u002Fspan\u003E\u003C\u002Fbutton\u003E\u003C\u002Fdiv\u003E\u003C\u002Fdiv\u003E\u003C\u002Fdiv\u003E\u003Cdiv class=\"card-body\"\u003E\u003Cdiv class=\"d-flex align-items-center\"\u003E\u003Ci class=\"icon fa-fw\" *ngIf=\"conn.icon &amp;&amp; !conn.icon.startsWith('&lt;')\" [class]=\"conn.icon\" [style.color]=\"conn.color\"\u003E\u003C\u002Fi\u003E\u003Cdiv class=\"icon\" *ngIf=\"conn.icon &amp;&amp; conn.icon.startsWith('&lt;')\" [fastHtmlBind]=\"conn.icon\" [style.color]=\"conn.color\"\u003E\u003C\u002Fdiv\u003E\u003Ch6 class=\"ms-2\" [title]=\"conn.name\"\u003E{{ conn.name }}\u003C\u002Fh6\u003E\u003C\u002Fdiv\u003E\u003Cdiv class=\"info-text\"\u003E\u003Cp class=\"mb-0\"\u003E{{ conn.type }}, {{ conn.options?.host || 'N\u002FA' }}, {{ conn.options?.user || 'N\u002FA' }}\u003C\u002Fp\u003E\u003C\u002Fdiv\u003E\u003C\u002Fdiv\u003E\u003C\u002Fdiv\u003E\u003C\u002Fdiv\u003E\u003C\u002Fdiv\u003E\u003C\u002Fdiv\u003E\u003C\u002Fdiv\u003E\u003Cdiv class=\"footer-help\" translate=\"opaqueglasshomepage.ui.help\"\u003E\u003C\u002Fdiv\u003E\u003C\u002Fdiv\u003E";;return pug_html;};
