#!/usr/bin/env python3
"""
Mouse Jiggler para Pop!_OS, Ubuntu y derivados Linux.
Indicador en la barra de tareas (Tray / AppIndicator) y botón flotante
para mover píxeles del ratón y mantener la sesión activa.
"""

import os
import sys
import time
import signal
import subprocess
import argparse
import json
from pathlib import Path

import gi
gi.require_version('Gtk', '3.0')
gi.require_version('GLib', '2.0')

try:
    gi.require_version('AyatanaAppIndicator3', '0.1')
    from gi.repository import AyatanaAppIndicator3 as appindicator
except (ValueError, ImportError):
    gi.require_version('AppIndicator3', '0.1')
    from gi.repository import AppIndicator3 as appindicator

from gi.repository import Gtk, GLib

try:
    gi.require_version('Notify', '0.7')
    from gi.repository import Notify
    HAS_NOTIFY = True
except (ValueError, ImportError):
    HAS_NOTIFY = False

CONFIG_DIR = Path.home() / ".config" / "mouse-jiggler"
CONFIG_FILE = CONFIG_DIR / "config.json"
PID_FILE = Path("/tmp/mouse_jiggler.pid")
AUTOSTART_FILE = Path.home() / ".config" / "autostart" / "mouse-jiggler.desktop"

# Detección de ruta de iconos (instalado o en repositorio)
SCRIPT_DIR = Path(__file__).resolve().parent
REPO_ASSETS_DIR = SCRIPT_DIR.parent / "assets"
USER_ICONS_DIR = Path.home() / ".local" / "share" / "icons" / "hicolor" / "scalable" / "apps"

def get_icon_path(name):
    user_path = USER_ICONS_DIR / f"{name}.svg"
    if user_path.exists():
        return str(user_path)
    repo_path = REPO_ASSETS_DIR / f"{name}.svg"
    if repo_path.exists():
        return str(repo_path)
    return "input-mouse-symbolic"

ICON_ACTIVE = get_icon_path("mouse-jiggler-active")
ICON_INACTIVE = get_icon_path("mouse-jiggler-inactive")

DEFAULT_CONFIG = {
    "enabled": True,
    "interval_seconds": 30,
    "notifications": True,
    "restore_position": True,
    "show_label": True,
    "only_if_idle": True,
    "step_pixels": 1,
    "floating_button": False
}


class MouseMoverApp:
    def __init__(self):
        Gtk.init(None)
        CONFIG_DIR.mkdir(parents=True, exist_ok=True)
        self.config = self.load_config()
        self.timer_id = None
        self.last_mouse_pos = None
        self.floating_win = None

        if HAS_NOTIFY:
            Notify.init("Mouse Jiggler")

        self.setup_indicator()
        self.setup_signals()

        # Estado inicial
        self.update_state(self.config["enabled"], notify=False)

        if self.config.get("floating_button", False):
            self.show_floating_button()

    def load_config(self):
        cfg = DEFAULT_CONFIG.copy()
        if CONFIG_FILE.exists():
            try:
                with open(CONFIG_FILE, "r") as f:
                    cfg.update(json.load(f))
            except Exception as e:
                print(f"Error cargando config: {e}")
        return cfg

    def save_config(self):
        try:
            with open(CONFIG_FILE, "w") as f:
                json.dump(self.config, f, indent=2)
        except Exception as e:
            print(f"Error guardando config: {e}")

    def notify(self, title, message):
        if not self.config.get("notifications", True) or not HAS_NOTIFY:
            return
        try:
            n = Notify.Notification.new(title, message, "input-mouse-symbolic")
            n.set_timeout(2000)
            n.show()
        except Exception as e:
            print(f"Error enviando notificación: {e}")

    def setup_indicator(self):
        self.indicator = appindicator.Indicator.new(
            "mouse-jiggler-indicator",
            "input-mouse-symbolic",
            appindicator.IndicatorCategory.APPLICATION_STATUS
        )
        self.indicator.set_status(appindicator.IndicatorStatus.ACTIVE)

        self.menu = Gtk.Menu()

        # Título / Cabecera
        title_item = Gtk.MenuItem(label="🖱️  Mouse Jiggler")
        title_item.set_sensitive(False)
        self.menu.append(title_item)
        self.menu.append(Gtk.SeparatorMenuItem())

        # Switch ON/OFF
        self.toggle_item = Gtk.CheckMenuItem(label="Movimiento automático activo")
        self.toggle_item.set_active(self.config["enabled"])
        self.toggle_item.connect("toggled", self.on_toggle_clicked)
        self.menu.append(self.toggle_item)

        # Mover 1px ahora
        move_now_item = Gtk.MenuItem(label="🎯 Mover ratón ahora (1 px)")
        move_now_item.connect("activate", lambda w: self.move_mouse(manual=True))
        self.menu.append(move_now_item)

        self.menu.append(Gtk.SeparatorMenuItem())

        # Submenú Intervalo
        interval_item = Gtk.MenuItem(label="⏱️  Intervalo de tiempo")
        interval_menu = Gtk.Menu()
        self.interval_group = None
        intervals = [
            (10, "Cada 10 segundos"),
            (30, "Cada 30 segundos"),
            (60, "Cada 1 minuto"),
            (120, "Cada 2 minutos"),
            (300, "Cada 5 minutos")
        ]
        for sec, text in intervals:
            r = Gtk.RadioMenuItem(group=self.interval_group, label=text)
            if self.interval_group is None:
                self.interval_group = r
            if self.config["interval_seconds"] == sec:
                r.set_active(True)
            r.connect("toggled", self.on_interval_selected, sec)
            interval_menu.append(r)
        interval_item.set_submenu(interval_menu)
        self.menu.append(interval_item)

        # Submenú Opciones
        opts_item = Gtk.MenuItem(label="⚙️  Opciones")
        opts_menu = Gtk.Menu()

        idle_item = Gtk.CheckMenuItem(label="Solo mover si no estoy usando el ratón")
        idle_item.set_active(self.config.get("only_if_idle", True))
        idle_item.connect("toggled", self.on_option_toggled, "only_if_idle")
        opts_menu.append(idle_item)

        notif_item = Gtk.CheckMenuItem(label="Notificaciones de escritorio")
        notif_item.set_active(self.config.get("notifications", True))
        notif_item.connect("toggled", self.on_option_toggled, "notifications")
        opts_menu.append(notif_item)

        label_item = Gtk.CheckMenuItem(label="Mostrar texto ON/OFF en panel")
        label_item.set_active(self.config.get("show_label", True))
        label_item.connect("toggled", self.on_label_option_toggled)
        opts_menu.append(label_item)

        autostart_item = Gtk.CheckMenuItem(label="Iniciar con el sistema al encender")
        autostart_item.set_active(AUTOSTART_FILE.exists())
        autostart_item.connect("toggled", self.on_autostart_toggled)
        opts_menu.append(autostart_item)

        opts_item.set_submenu(opts_menu)
        self.menu.append(opts_item)

        # Botón flotante
        float_item = Gtk.CheckMenuItem(label="🪟  Mostrar botón flotante en pantalla")
        float_item.set_active(self.config.get("floating_button", False))
        float_item.connect("toggled", self.on_floating_toggle)
        self.menu.append(float_item)

        self.menu.append(Gtk.SeparatorMenuItem())

        # Salir
        quit_item = Gtk.MenuItem(label="❌ Salir")
        quit_item.connect("activate", self.on_quit)
        self.menu.append(quit_item)

        self.menu.show_all()
        self.indicator.set_menu(self.menu)

    def on_label_option_toggled(self, widget):
        self.config["show_label"] = widget.get_active()
        self.save_config()
        self.update_indicator_visuals()

    def on_option_toggled(self, widget, key):
        self.config[key] = widget.get_active()
        self.save_config()

    def on_autostart_toggled(self, widget):
        enable = widget.get_active()
        if enable:
            AUTOSTART_FILE.parent.mkdir(parents=True, exist_ok=True)
            desktop_content = f"""[Desktop Entry]
Type=Application
Name=Mouse Jiggler
Comment=Mover píxeles del ratón automáticamente
Exec={os.path.expanduser('~/.local/bin/mouse-jiggler')}
Icon=input-mouse-symbolic
Terminal=false
Categories=Utility;
X-GNOME-Autostart-enabled=true
"""
            AUTOSTART_FILE.write_text(desktop_content)
            self.notify("Mouse Jiggler", "Inicio automático activado")
        else:
            if AUTOSTART_FILE.exists():
                AUTOSTART_FILE.unlink()
            self.notify("Mouse Jiggler", "Inicio automático desactivado")

    def on_interval_selected(self, widget, seconds):
        if widget.get_active():
            self.config["interval_seconds"] = seconds
            self.save_config()
            if self.config["enabled"]:
                self.restart_timer()
            self.notify("Mouse Jiggler", f"Intervalo cambiado a {seconds} segundos")

    def on_toggle_clicked(self, widget):
        is_active = widget.get_active()
        if is_active != self.config["enabled"]:
            self.update_state(is_active)

    def toggle_state(self):
        new_state = not self.config["enabled"]
        self.toggle_item.set_active(new_state)

    def update_state(self, enabled, notify=True):
        self.config["enabled"] = enabled
        self.save_config()

        if enabled:
            self.restart_timer()
            if notify:
                self.notify("Mouse Jiggler", f"🟢 Activado (Moviendo cada {self.config['interval_seconds']}s)")
        else:
            self.stop_timer()
            if notify:
                self.notify("Mouse Jiggler", "⚪ Desactivado / Pausado")

        self.update_indicator_visuals()
        if self.floating_win:
            self.update_floating_win_ui()

    def update_indicator_visuals(self):
        is_on = self.config["enabled"]
        icon_path = ICON_ACTIVE if is_on and os.path.exists(ICON_ACTIVE) else ICON_INACTIVE
        if os.path.exists(icon_path):
            self.indicator.set_icon_full(icon_path, "Mouse Jiggler")
        else:
            self.indicator.set_icon("input-mouse-symbolic")

        if self.config.get("show_label", True):
            self.indicator.set_label("🟢 ON" if is_on else "⚪ OFF", "guide")
        else:
            self.indicator.set_label("", "")

    def restart_timer(self):
        self.stop_timer()
        interval_ms = int(self.config["interval_seconds"] * 1000)
        self.timer_id = GLib.timeout_add(interval_ms, self.timer_tick)

    def stop_timer(self):
        if self.timer_id:
            GLib.source_remove(self.timer_id)
            self.timer_id = None

    def get_current_mouse_pos(self):
        try:
            res = subprocess.run(
                ['xdotool', 'getmouselocation', '--shell'],
                capture_output=True, text=True, timeout=1
            )
            data = {}
            for line in res.stdout.strip().split('\n'):
                if '=' in line:
                    k, v = line.split('=', 1)
                    data[k] = int(v)
            return (data.get('X', 0), data.get('Y', 0))
        except Exception:
            return None

    def timer_tick(self):
        if not self.config["enabled"]:
            return False

        if self.config.get("only_if_idle", True):
            current_pos = self.get_current_mouse_pos()
            if current_pos and self.last_mouse_pos:
                if current_pos != self.last_mouse_pos:
                    self.last_mouse_pos = current_pos
                    return True

        self.move_mouse(manual=False)
        return True

    def move_mouse(self, manual=False):
        step = self.config.get("step_pixels", 1)
        try:
            subprocess.run(['xdotool', 'mousemove_relative', '--', str(step), '0'], check=True, timeout=1)
            time.sleep(0.04)
            if self.config.get("restore_position", True):
                subprocess.run(['xdotool', 'mousemove_relative', '--', f"-{step}", '0'], check=True, timeout=1)

            self.last_mouse_pos = self.get_current_mouse_pos()

            if manual:
                self.notify("Mouse Jiggler", f"🎯 Ratón movido ({step}px)")
        except Exception as e:
            print(f"Error moviendo ratón con xdotool: {e}")

    # ================= Botón Flotante =================
    def on_floating_toggle(self, widget):
        show = widget.get_active()
        self.config["floating_button"] = show
        self.save_config()
        if show:
            self.show_floating_button()
        else:
            if self.floating_win:
                self.floating_win.destroy()
                self.floating_win = None

    def show_floating_button(self):
        if self.floating_win:
            self.floating_win.present()
            return

        win = Gtk.Window(type=Gtk.WindowType.TOPLEVEL)
        win.set_title("Mouse Jiggler")
        win.set_keep_above(True)
        win.set_decorated(False)
        win.set_resizable(False)
        win.set_skip_taskbar_hint(True)
        win.set_skip_pager_hint(True)

        css = b"""
        window {
            background-color: rgba(30, 30, 46, 0.94);
            border-radius: 12px;
            border: 1px solid rgba(255, 255, 255, 0.2);
            padding: 4px;
        }
        button {
            border-radius: 8px;
            padding: 4px 10px;
            font-weight: bold;
            font-size: 12px;
        }
        .btn-active {
            background: #16a34a;
            color: #ffffff;
        }
        .btn-inactive {
            background: #4b5563;
            color: #d1d5db;
        }
        """
        style_provider = Gtk.CssProvider()
        style_provider.load_from_data(css)
        Gtk.StyleContext.add_provider_for_screen(
            win.get_screen(),
            style_provider,
            Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION
        )

        box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=6)
        box.set_margin_top(4)
        box.set_margin_bottom(4)
        box.set_margin_start(6)
        box.set_margin_end(6)

        drag_label = Gtk.Label(label="🖱️")
        box.pack_start(drag_label, False, False, 0)

        self.float_toggle_btn = Gtk.Button()
        self.float_toggle_btn.connect("clicked", lambda b: self.toggle_state())
        box.pack_start(self.float_toggle_btn, False, False, 0)

        move_btn = Gtk.Button(label="🎯 1px")
        move_btn.set_tooltip_text("Mover 1 píxel ahora")
        move_btn.connect("clicked", lambda b: self.move_mouse(manual=True))
        box.pack_start(move_btn, False, False, 0)

        close_btn = Gtk.Button(label="×")
        close_btn.set_tooltip_text("Ocultar botón flotante")
        close_btn.connect("clicked", lambda b: self.on_floating_toggle_from_win())
        box.pack_start(close_btn, False, False, 0)

        win.add_events(gi.repository.Gdk.EventMask.BUTTON_PRESS_MASK)
        win.connect("button-press-event", self.on_win_drag)

        win.add(box)
        win.show_all()

        screen = win.get_screen()
        w = screen.get_width()
        h = screen.get_height()
        win.move(w - 220, h - 140)

        self.floating_win = win
        self.update_floating_win_ui()

    def on_win_drag(self, widget, event):
        if event.button == 1:
            widget.begin_move_drag(event.button, int(event.x_root), int(event.y_root), event.time)

    def on_floating_toggle_from_win(self):
        for item in self.menu.get_children():
            if isinstance(item, Gtk.CheckMenuItem) and "botón flotante" in item.get_label():
                item.set_active(False)
                break

    def update_floating_win_ui(self):
        if not self.floating_win:
            return
        is_on = self.config["enabled"]
        ctx = self.float_toggle_btn.get_style_context()
        if is_on:
            self.float_toggle_btn.set_label("Activo")
            ctx.remove_class("btn-inactive")
            ctx.add_class("btn-active")
        else:
            self.float_toggle_btn.set_label("Pausado")
            ctx.remove_class("btn-active")
            ctx.add_class("btn-inactive")

    # ================= Señales del sistema y Salida =================
    def setup_signals(self):
        GLib.unix_signal_add(GLib.PRIORITY_DEFAULT, signal.SIGUSR1, self.sig_toggle_handler)
        GLib.unix_signal_add(GLib.PRIORITY_DEFAULT, signal.SIGUSR2, self.sig_move_handler)
        GLib.unix_signal_add(GLib.PRIORITY_DEFAULT, signal.SIGINT, self.on_quit)
        GLib.unix_signal_add(GLib.PRIORITY_DEFAULT, signal.SIGTERM, self.on_quit)

    def sig_toggle_handler(self):
        self.toggle_state()
        return True

    def sig_move_handler(self):
        self.move_mouse(manual=True)
        return True

    def on_quit(self, *args):
        self.stop_timer()
        if PID_FILE.exists():
            try:
                PID_FILE.unlink()
            except Exception:
                pass
        Gtk.main_quit()
        sys.exit(0)


def send_signal_to_running(sig):
    if PID_FILE.exists():
        try:
            pid = int(PID_FILE.read_text().strip())
            os.kill(pid, sig)
            return True
        except (ValueError, ProcessLookupError):
            PID_FILE.unlink(missing_ok=True)
    return False


def main():
    parser = argparse.ArgumentParser(description="Mouse Jiggler para Pop!_OS / Ubuntu Linux")
    parser.add_argument("--toggle", action="store_true", help="Alternar estado activo/inactivo")
    parser.add_argument("--move-now", action="store_true", help="Mover 1 píxel inmediatamente")
    parser.add_argument("--stop", action="store_true", help="Detener la aplicación")
    parser.add_argument("--status", action="store_true", help="Consultar estado")
    args = parser.parse_args()

    if args.toggle:
        if send_signal_to_running(signal.SIGUSR1):
            print("Estado alternado (SIGUSR1 enviado a la instancia)")
        else:
            print("Mouse Jiggler no está en ejecución. Iniciando...")
            subprocess.Popen([sys.executable, str(Path(__file__).resolve())])
        sys.exit(0)

    elif args.move_now:
        subprocess.run(['xdotool', 'mousemove_relative', '--', '1', '0'])
        time.sleep(0.04)
        subprocess.run(['xdotool', 'mousemove_relative', '--', '-1', '0'])
        print("Ratón movido 1px inmediatamente")
        sys.exit(0)

    elif args.stop:
        if send_signal_to_running(signal.SIGTERM):
            print("Mouse Jiggler detenido")
        else:
            print("No se encontró instancia en ejecución")
        sys.exit(0)

    elif args.status:
        if PID_FILE.exists():
            print(f"Mouse Jiggler está corriendo con PID {PID_FILE.read_text().strip()}")
        else:
            print("Mouse Jiggler no está corriendo")
        sys.exit(0)

    # Evitar instancias duplicadas
    if PID_FILE.exists():
        try:
            pid = int(PID_FILE.read_text().strip())
            os.kill(pid, 0)
            print(f"Mouse Jiggler ya se está ejecutando (PID: {pid}).")
            sys.exit(0)
        except (ValueError, ProcessLookupError):
            PID_FILE.unlink(missing_ok=True)

    PID_FILE.write_text(str(os.getpid()))

    app = MouseMoverApp()
    Gtk.main()


if __name__ == "__main__":
    main()
